# ------------------------------------------------------------------
# President University Concentration Recommendation System
# Environment variable template. Contains NO real credentials.
# Copy to .env and fill in your own values:
#   cp .env.example .env
# ------------------------------------------------------------------

# Supabase PostgreSQL — transaction-mode pooler (application/runtime connection)
# Port: 6543
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<DATABASE_PASSWORD>@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase PostgreSQL — session-mode pooler (Prisma CLI / migrations connection)
# Port: 5432
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<DATABASE_PASSWORD>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------
# Admin authentication (STEP 9)
# ------------------------------------------------------------------

# Secret used to sign the admin session cookie (JWT, HS256).
# REQUIRED. Generate a strong value, for example:
#   openssl rand -base64 32
# Never use NEXT_PUBLIC_AUTH_SECRET. Server-side only.
AUTH_SECRET=""

# Initial admin account, provisioned with:  npm run db:seed
# ADMIN_EMAIL is normalized (trimmed + lowercased) before storage.
# ADMIN_PASSWORD is bcrypt-hashed (cost 12); only the hash is stored.
# Use a long, unique password (at least 12 characters).
# Placeholders only — do not commit real credentials.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
